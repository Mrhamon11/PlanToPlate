# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
#
# Docker Compose interpolates $VAR / ${VAR} in THIS file's values, not just in compose.yaml —
# a literal `$` in anything you paste below is silently stripped unless doubled as `$$`. This
# matters most for generated secrets and passwords, since the corruption is quiet: no error,
# just a weaker value than the one you generated. `make secret` avoids the problem by
# generating a key that never contains `$`; if you set a Postgres password or anything else
# by hand, either avoid `$` or escape it as `$$`.
#
# SECRET_KEY has no default anywhere in the app. Generate one with `make secret`.
SECRET_KEY=

# true/false. Leave unset (or false) outside local development.
DEBUG=false

# Comma-separated list of hostnames this deployment answers to. Set this to your real
# domain when you move off localhost (see SITE_ADDRESS below) — config/settings/prod.py
# always appends 127.0.0.1 on top of whatever you list here, so you do not need to add it
# yourself. That entry exists purely for the Compose healthcheck, which hits gunicorn
# directly at http://127.0.0.1:8000/healthz/ and cannot use the public hostname; the app
# port is not published, so only Caddy and the healthcheck can reach it.
ALLOWED_HOSTS=localhost,127.0.0.1

# django-environ URL form. Left unset here: base.py's default (an absolute path to
# db.sqlite3 next to manage.py) is better than the CWD-relative form below, which makes the
# database file follow whatever directory you happen to run commands from. Under Docker
# Compose, compose.yaml supplies its own default (the named volume at /app/data) unless you
# set this to something else — e.g. to switch to Postgres, uncomment the `postgres` service
# in compose.yaml and set:
# DATABASE_URL=postgres://plantoplate:<password>@postgres:5432/plantoplate
# DATABASE_URL=sqlite:///db.sqlite3

# Switches the Docker image build to include the psycopg[binary] driver (the optional
# `postgres` dependency group in pyproject.toml). Only needed alongside the Postgres
# DATABASE_URL above — leave unset (or false) for the default SQLite build, which never
# installs the driver. Requires a rebuild to take effect: `docker compose up --build`.
# INCLUDE_POSTGRES=true

# Only used by the commented-out `postgres` service in compose.yaml.
# POSTGRES_DB=plantoplate
# POSTGRES_USER=plantoplate
# POSTGRES_PASSWORD=

# Docker Compose / Caddy only. The hostname Caddy serves and automatically provisions TLS
# for. "localhost" (the default) gets a self-signed cert from Caddy's internal CA — fine for
# a home LAN reached over Tailscale. Set this to a real domain to get a publicly trusted
# Let's Encrypt certificate instead; no other file needs to change.
# SITE_ADDRESS=localhost
